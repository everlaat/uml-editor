{
  "name": "uml-editor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A fast, local-first UML and flowchart editor that runs entirely in the browser.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "pretest": "esbuild src/testables.ts --bundle --format=esm --platform=node --outfile=test/.build/testables.mjs --log-level=warning"
  },
  "devDependencies": {
    "esbuild": "^0.21.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
